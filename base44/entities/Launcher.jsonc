      "enum": [
        "String",
        "Winder",
        "Sword",
        "Custom"
      ],
      "description": "Tipo de lanzador"
    },
    "image_url": {
      "type": "string",
      "description": "URL de la imagen"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
