{
  "name": "Launcher",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del lanzador"
    },
    "spin_direction": {
      "type": "string",
      "enum": [
        "Derecha",
        "Izquierda"
      ],
      "description": "Direcci\u00f3n de giro"
    },
    "type": {
