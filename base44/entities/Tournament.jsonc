{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del torneo"
    },
    "mode": {
      "type": "string",
      "enum": [
        "Eliminaci\u00f3n Directa",
        "Round Robin"
      ],
      "description": "Modo del torneo"
    },
    "point_limit": {
      "type": "number",
      "default": 5,
      "description": "Puntos para ganar un combate"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Progreso",
        "Finalizado"
      ],
      "default": "Pendiente"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "combo_id": {
            "type": "string"
          },
          "combo_name": {
            "type": "string"
          },
          "wins": {
            "type": "number",
            "default": 0
          },
          "losses": {
            "type": "number",
            "default": 0
          },
          "points": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round": {
            "type": "number"
          },
          "match_number": {
            "type": "number"
          },
          "player_a": {
            "type": "string"
          },
          "player_b": {
            "type": "string"
          },
          "winner": {
            "type": "string"
          },
          "score_a": {
            "type": "number",
            "default": 0
          },
          "score_b": {
            "type": "number",
            "default": 0
          },
          "rounds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "winner": {
                  "type": "string"
                },
                "finish_type": {
                  "type": "string"
                },
                "points": {
                  "type": "number"
                }
              }
            }
          },
          "completed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "winner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "mode"
  ]
}