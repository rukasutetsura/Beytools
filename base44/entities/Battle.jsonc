      "description": "Puntos otorgados"
    },
    "notes": {
      "type": "string"
    },
    "tournament_id": {
      "type": "string",
      "description": "ID del torneo (si aplica)"
    }
  },
  "required": [
    "player_a_name",
    "player_b_name",
    "winner",
    "finish_type"
