    },
    "player_a_combo_id": {
      "type": "string"
    },
    "player_a_combo_name": {
      "type": "string"
    },
    "player_a_launcher_id": {
      "type": "string"
    },
    "player_a_launcher_name": {
      "type": "string"
    },
    "player_b_name": {
      "type": "string",
      "description": "Nombre del Jugador B"
    },
    "player_b_combo_id": {
      "type": "string"
    },
    "player_b_combo_name": {
      "type": "string"
    },
    "player_b_launcher_id": {
      "type": "string"
    },
    "player_b_launcher_name": {
      "type": "string"
    },
    "winner": {
      "type": "string",
      "enum": [
